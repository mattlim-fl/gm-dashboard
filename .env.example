# =============================================================================
# Frontend Environment Variables
# =============================================================================
# These are used by the Vite frontend application.
# Copy this file to .env and fill in your values.

# Supabase Configuration (Required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# API Configuration (Required for production)
VITE_API_BASE_URL=/.netlify/functions/api

# Optional: Local development overrides
# VITE_DEV_MODE=true
# VITE_MANOR_UI_DEV_URL=http://localhost:3001
# VITE_HIPPIE_UI_DEV_URL=http://localhost:3002
