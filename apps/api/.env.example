# =============================================================================
# API Server Environment Variables (apps/api)
# =============================================================================
# These are used by the Node.js API server (Netlify Functions).
# Copy this file to .env and fill in your values.

# Server Configuration
PORT=4000

# Supabase Configuration (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Credentials Encryption (Required)
# 64-character hex string for AES-256 encryption of stored API credentials
# Generate with: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=your-64-char-hex-key

# Xero OAuth (Required for P&L reporting)
XERO_CLIENT_ID=your-xero-client-id
XERO_CLIENT_SECRET=your-xero-client-secret
XERO_REDIRECT_URI=http://localhost:4000/xero/callback
XERO_SCOPES="offline_access accounting.settings.read accounting.reports.read"

# CORS Configuration (comma-separated origins)
API_ALLOWED_ORIGINS=https://gm-dashboard.getproductbox.com,http://localhost:5173

# Cron Secret (for authenticating edge function callbacks)
API_CRON_SECRET=your-cron-secret
